{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FotoNest expense review ledger (not app import)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "account",
    "records",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "fotonest.expenses.review"
    },
    "version": {
      "const": 1
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "material",
          "title",
          "evidence",
          "note",
          "measure",
          "amount",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "source": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "material": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "measure": {
            "enum": [
              "bill_total",
              "invoice_total",
              "payment_entry",
              "balance",
              "deposit_entry",
              "refund_entry",
              "credit_total"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
          },
          "currency": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            ]
          }
        }
      }
    }
  }
}
