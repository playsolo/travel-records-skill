{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FotoNest travel import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "records"
  ],
  "properties": {
    "format": {
      "const": "fotonest.travel"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "kind",
          "title",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "hotel",
              "flight",
              "dining"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
              }
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
              }
            ]
          },
          "origin": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            ]
          },
          "destination": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            ]
          },
          "status": {
            "enum": [
              "unknown",
              "reserved",
              "processing",
              "cancelled",
              "completed"
            ]
          },
          "evidence": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 6,
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "start": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "end": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "origin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  }
}
